            "mimeType": "application/json",
            "text": "{\"operationName\":\"getVisitPatientBoardList\",\"variables\":{\"locationIds\":null,\"serviceIds\":null,\"txStatuses\":null,\"providerIds\":[\"198\"],\"wardIds\":null,\"workflowTagIds\":null,\"currentUserId\":\"198\",\"statuses\":null,\"since\":null},\"query\":\"query getVisitPatientBoardList($currentUserId: ID, $statuses: [VisitStatus], $providerIds: [ID], $locationIds: [ID], $serviceIds: [ID], $txStatuses: [TreatmentStatus], $wardIds: [ID], $workflowTagIds: [ID], $since: Datetime) {\\n  activeVisits(params: {statuses: $statuses, providerIds: $providerIds, locationIds: $locationIds, serviceIds: $serviceIds, treatmentStatuses: $txStatuses, wardIds: $wardIds, workflowTagIds: $workflowTagIds}) {\\n    ...visitPatientBoard\\n    __typename\\n  }\\n  listRecentlyCheckedOutVisits(since: $since) {\\n    id\\n    ...visitPatientBoard\\n    __typename\\n  }\\n  user(id: $currentUserId) {\\n    id\\n    pinnedPatients {\\n      id\\n      lastVisit {\\n        ...visitPatientBoard\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment visitPatientBoard on Visit {\\n  id\\n  triageTag {\\n    ...triageTagInfo\\n    __typename\\n  }\\n  ...visitAssignedTo\\n  ...visitInfo\\n  ...visitPatient\\n  ...visitReadyToAdmit\\n  ...visitReadyToGo\\n  ...visitUser\\n  ...visitVisitAlerts\\n  ...visitWard\\n  ...visitLastPatientInfo\\n  ...visitTreatmentStatus\\n  __typename\\n}\\n\\nfragment triageTagInfo on TriageTag {\\n  key\\n  label\\n  abbreviation\\n  color\\n  position\\n  __typename\\n}\\n\\nfragment visitAssignedTo on Visit {\\n  assignedTo {\\n    ...userInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment userInfo on User {\\n  id\\n  instinctId\\n  nameFirst\\n  nameLast\\n  credentials\\n  initials\\n  status\\n  pinCode\\n  isActive\\n  isProtected\\n  isWhiteboard\\n  username\\n  authType\\n  avatar {\\n    kind\\n    accent\\n    illustrationKey\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment visitInfo on Visit {\\n  id\\n  checkInAt\\n  checkOutAt\\n  codeStatus {\\n    ...codeStatusInfo\\n    __typename\\n  }\\n  scheduledAt\\n  summary\\n  reason\\n  summary\\n  toGoHomeAt\\n  belongings\\n  status\\n  isCritical\\n  isActive\\n  readyToCheckout\\n  readyToGo {\\n    insertedAt\\n    __typename\\n  }\\n  location {\\n    id\\n    label\\n    __typename\\n  }\\n  user {\\n    id\\n    __typename\\n  }\\n  ward {\\n    id\\n    __typename\\n  }\\n  service {\\n    id\\n    __typename\\n  }\\n  exam {\\n    id\\n    __typename\\n  }\\n  hospitalization {\\n    id\\n    __typename\\n  }\\n  alerts {\\n    id\\n    label\\n    __typename\\n  }\\n  patient {\\n    id\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment codeStatusInfo on CodeStatus {\\n  id\\n  label\\n  abbreviation\\n  __typename\\n}\\n\\nfragment visitPatient on Visit {\\n  id\\n  lastPatientWeight\\n  patient {\\n    ...patientInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment patientInfo on Patient {\\n  id\\n  name\\n  nameLast\\n  profilePictureUrl\\n  birthDate\\n  color\\n  deceasedDt\\n  deceasedDate\\n  pimsId\\n  signalment\\n  account {\\n    id\\n    primaryContact {\\n      id\\n      nameFirst\\n      nameLast\\n      __typename\\n    }\\n    __typename\\n  }\\n  activeVisit {\\n    id\\n    __typename\\n  }\\n  lastVisit {\\n    id\\n    __typename\\n  }\\n  species {\\n    key\\n    label\\n    abbreviation\\n    bsaK\\n    sortOrder\\n    __typename\\n  }\\n  breed {\\n    id\\n    label\\n    abbreviation\\n    __typename\\n  }\\n  sex {\\n    key\\n    label\\n    abbreviation\\n    __typename\\n  }\\n  alerts {\\n    id\\n    label\\n    __typename\\n  }\\n  microchipInfo {\\n    id\\n    provider {\\n      key\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n  insuranceInfo {\\n    id\\n    provider {\\n      key\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment visitReadyToAdmit on Visit {\\n  readyToAdmit {\\n    insertedAt\\n    user {\\n      id\\n      ...userInfo\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment visitReadyToGo on Visit {\\n  readyToGo {\\n    insertedAt\\n    user {\\n      id\\n      ...userInfo\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment visitUser on Visit {\\n  user {\\n    ...userInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment visitVisitAlerts on Visit {\\n  alerts {\\n    ...alertInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment alertInfo on Alert {\\n  id\\n  label\\n  __typename\\n}\\n\\nfragment visitWard on Visit {\\n  ward {\\n    ...wardInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment wardInfo on Ward {\\n  id\\n  label\\n  abbreviation\\n  isActive\\n  feeProducts {\\n    ...feeProducts\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment feeProducts on FeeProduct {\\n  schedule {\\n    type\\n    frequencyInMinutes\\n    dailyTimes\\n    __typename\\n  }\\n  feeProduct {\\n    ...feeProduct\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment feeProduct on Product {\\n  id\\n  label\\n  defaultSchedule {\\n    type\\n    frequencyInMinutes\\n    dailyTimes\\n    __typename\\n  }\\n  pimsId\\n  __typename\\n}\\n\\nfragment visitLastPatientInfo on Visit {\\n  id\\n  lastPatientWeight\\n  __typename\\n}\\n\\nfragment visitTreatmentStatus on Visit {\\n  id\\n  treatmentStatus\\n  __typename\\n}\\n\"}"
          }
