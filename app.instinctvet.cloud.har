            "mimeType": "application/json",
            "text": "{\"operationName\":\"getAccountById\",\"variables\":{\"id\":\"17579316-5a67-41e4-90ef-0ae73f4b9c9c\"},\"query\":\"query getAccountById($id: ID!) {\\n  account(id: $id) {\\n    ...accountInfo\\n    __typename\\n  }\\n}\\n\\nfragment accountInfo on Account {\\n  id\\n  eligibleForLateFees\\n  isTaxExempt\\n  label\\n  note\\n  pimsCode\\n  isTestAccount\\n  accountAlerts {\\n    id\\n    label\\n    deactivatedAt\\n    __typename\\n  }\\n  accountTypes {\\n    id\\n    label\\n    __typename\\n  }\\n  discountClass {\\n    id\\n    __typename\\n  }\\n  primaryContact {\\n    ...contactInfo\\n    __typename\\n  }\\n  alternateContacts {\\n    ...contactInfo\\n    __typename\\n  }\\n  isTestAccount\\n  __typename\\n}\\n\\nfragment contactInfo on Contact {\\n  id\\n  nameFirst\\n  nameMiddle\\n  nameLast\\n  note\\n  isActive\\n  birthDate\\n  governmentId\\n  title {\\n    key\\n    __typename\\n  }\\n  accounts {\\n    id\\n    pimsCode\\n    __typename\\n  }\\n  communicationDetails {\\n    ...communicationDetailInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment communicationDetailInfo on CommunicationDetail {\\n  id\\n  type\\n  value\\n  label\\n  note\\n  placeId\\n  isPreferred\\n  displayValue\\n  knownIssues\\n  communicationPreference {\\n    id\\n    allowCommunication\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
          }
