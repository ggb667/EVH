            "text": "{\"operationName\":\"getCurrentUser\",\"variables\":{},\"query\":\"query getCurrentUser {\\n  currentUser {\\n    ...userInfo\\n    ...userPermissions\\n    ...userPreferences\\n    roles {\\n      id\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment userInfo on User {\\n  id\\n  instinctId\\n  nameFirst\\n  nameLast\\n  credentials\\n  initials\\n  status\\n  pinCode\\n  isActive\\n  isProtected\\n  isWhiteboard\\n  username\\n  authType\\n  avatar {\\n    kind\\n    accent\\n    illustrationKey\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment userPermissions on User {\\n  permissions {\\n    ...permissionInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment permissionInfo on Permission {\\n  key\\n  label\\n  description\\n  __typename\\n}\\n\\nfragment userPreferences on User {\\n  id\\n  userPreferences {\\n    preferenceKey\\n    value\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
