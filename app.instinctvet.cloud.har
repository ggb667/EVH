            "mimeType": "application/json",
            "text": "{\"operationName\":\"getLocationByInstinctId\",\"variables\":{\"instinctId\":\"71ae771c-233f-4ad9-b880-fd79737bd00d\"},\"query\":\"query getLocationByInstinctId($instinctId: ID!) {\\n  locationByInstinctId(instinctId: $instinctId) {\\n    ...locationInfo\\n    market {\\n      id\\n      placesApiKey\\n      ietfTag\\n      timeFormat\\n      timezone\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment locationInfo on Location {\\n  id\\n  instinctId\\n  currencyCode\\n  currencyFormat\\n  ietfTag\\n  label\\n  abbreviation\\n  address\\n  phone\\n  emailAddress\\n  gravityApiBaseUrl\\n  emrStartDate\\n  addressLineOne\\n  addressLineTwo\\n  city\\n  stateProvince\\n  postalCode\\n  country\\n  rxPrintFormat\\n  locale {\\n    key\\n    timeFormat\\n    ietfTag\\n    currency {\\n      key\\n      label\\n      symbol\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
