            "text": "{\"operationName\":\"getAccountLedger\",\"variables\":{\"id\":\"17579316-5a67-41e4-90ef-0ae73f4b9c9c\"},\"query\":\"query getAccountLedger($id: ID!) {\\n  account(id: $id) {\\n    id\\n    accountTypes {\\n      id\\n      label\\n      __typename\\n    }\\n    isTestAccount\\n    pimsCode\\n    label\\n    accountAlerts {\\n      id\\n      label\\n      __typename\\n    }\\n    primaryContact {\\n      ...contactInfo\\n      __typename\\n    }\\n    runningLedger {\\n      balance\\n      hasOutstandingLateFees\\n      totalCredits\\n      totalDebits\\n      unappliedPaymentAmount\\n      invoicesToReview {\\n        id\\n        balance\\n        __typename\\n      }\\n      agedBalances {\\n        current\\n        over30\\n        over60\\n        over90\\n        over120\\n        __typename\\n      }\\n      ledgerItems {\\n        ...accountLedgerItem\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment contactInfo on Contact {\\n  id\\n  nameFirst\\n  nameMiddle\\n  nameLast\\n  birthDate\\n  governmentId\\n  note\\n  isActive\\n  title {\\n    key\\n    __typename\\n  }\\n  accounts {\\n    id\\n    pimsCode\\n    __typename\\n  }\\n  communicationDetails {\\n    ...communicationDetailInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment communicationDetailInfo on CommunicationDetail {\\n  id\\n  type\\n  value\\n  label\\n  note\\n  placeId\\n  isPreferred\\n  displayValue\\n  knownIssues\\n  communicationPreference {\\n    id\\n    allowCommunication\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment accountLedgerItem on AccountLedgerItem {\\n  availableAmountToUnapply\\n  amountRefundable\\n  balance\\n  currentInvoiceBalance\\n  checkInAt\\n  checkOutAt\\n  credit\\n  creditCardEndingIn\\n  creditCardType\\n  debit\\n  insuranceType\\n  entityId\\n  invoiceId\\n  invoiceDisplayId\\n  invoiceStatus\\n  invoiceClosedAt\\n  invoiceClosedBy {\\n    id\\n    nameFull\\n    init