            "mimeType": "application/json",
            "text": "{\"operationName\":\"GetAccountFormPatients\",\"variables\":{\"accountId\":\"17579316-5a67-41e4-90ef-0ae73f4b9c9c\",\"limit\":10,\"page\":0},\"query\":\"query GetAccountFormPatients($accountId: ID!, $limit: Int, $page: Int) {\\n  account(id: $accountId) {\\n    id\\n    numberOfPatients\\n    patients(limit: $limit, page: $page) {\\n      ...accountPatient\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment accountPatient on Patient {\\n  ...patientInfo\\n  microchipInfo {\\n    id\\n    provider {\\n      key\\n      __typename\\n    }\\n    __typename\\n  }\\n  insuranceInfo {\\n    id\\n    provider {\\n      key\\n      __typename\\n    }\\n    __typename\\n  }\\n  discountClass {\\n    id\\n    __typename\\n  }\\n  consolidatedReferrers {\\n    ...consolidatedReferrersWithDoctors\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment patientInfo on Patient {\\n  id\\n  name\\n  nameLast\\n  birthDate\\n  color\\n  deceasedDt\\n  pimsId\\n  signalment\\n  account {\\n    id\\n    __typename\\n  }\\n  activeVisit {\\n    id\\n    __typename\\n  }\\n  lastVisit {\\n    id\\n    __typename\\n  }\\n  species {\\n    key\\n    label\\n    abbreviation\\n    bsaK\\n    sortOrder\\n    __typename\\n  }\\n  breed {\\n    id\\n    label\\n    abbreviation\\n    __typename\\n  }\\n  sex {\\n    key\\n    label\\n    abbreviation\\n    __typename\\n  }\\n  alerts {\\n    id\\n    label\\n    __typename\\n  }\\n  microchipInfo {\\n    id\\n    provider {\\n      key\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n  insuranceInfo {\\n    id\\n    provider {\\n      key\\n      label\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment consolidatedReferrersWithDoctors on ConsolidatedPatientReferrer {\\n  id\\n  referringPractice {\\n    ...referringPracticeFields\\n    __typename\\n  }\\n  referringDoctors {\\n    ...referringDoctorFields\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment referringPracticeFields on ReferringPractice {\\n  id\\n  label\\n  sharevilleEmail\\n  internalNotes\\n  types\\n  placeId\\n  allowSharevilleNotifications\\n  communicationDetails {\\n    ...communicationHelpersFragment\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment communicationHelpersFragment on CommunicationDetail {\\n  id\\n  value\\n  type\\n  label\\n  isPreferred\\n  note\\n  placeId\\n  displayValue\\n  communicationPreference {\\n    id\\n    allowCommunication\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment referringDoctorFields on ReferringDoctor {\\n  nameLast\\n  nameMiddle\\n  nameFirst\\n  id\\n  title {\\n    abbreviation\\n    key\\n    label\\n    __typename\\n  }\\n  internalNotes\\n  role\\n  credentials\\n  referringPractice {\\n    id\\n    __typename\\n  }\\n  communicationDetails {\\n    ...communicationHelpersFragment\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
