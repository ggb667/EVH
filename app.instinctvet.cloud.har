            "text": "{\"operationName\":\"getAccountsFinancials\",\"variables\":{\"params\":{\"includeZeroBalances\":false},\"overdueInvoicesOnly\":false},\"query\":\"query getAccountsFinancials($params: ListAccountsParams, $overdueInvoicesOnly: Boolean) {\\n  accounts(params: $params) {\\n    ...financialsAccountInfo\\n    runningLedger(summary: true, overdueInvoicesOnly: $overdueInvoicesOnly) {\\n      balance\\n      unappliedPaymentAmount\\n      invoicesToReview {\\n        id\\n        balance\\n        __typename\\n      }\\n      agedBalances {\\n        current\\n        over30\\n        over60\\n        over90\\n        over120\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment financialsAccountInfo on Account {\\n  id\\n  pimsCode\\n  label\\n  isTestAccount\\n  numberOfPatients\\n  accountAlerts {\\n    id\\n    label\\n    __typename\\n  }\\n  primaryContact {\\n    id\\n    nameFirst\\n    nameLast\\n    communicationDetails {\\n      id\\n      type\\n      value\\n      label\\n      displayValue\\n      isPreferred\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
