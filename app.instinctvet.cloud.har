          "postData": {
            "mimeType": "application/json",
            "text": "{\"operationName\":\"getCalendarAppointments\",\"variables\":{\"params\":{\"startDate\":\"2026-08-29\",\"endDate\":\"2026-08-29\",\"providerIds\":[\"199\",\"200\",\"212\",\"133\",\"224\",\"225\"],\"filters\":{\"calendarEntries\":[\"DROPOFF_AVAILABILITY\"]}},\"dropoffStatuses\":[\"ACTIVE\",\"NO_SHOW\"]},\"query\":\"query getCalendarAppointments($params: CalendarsParams!, $dropoffStatuses: [CalendarAppointmentStatus]) {\\n  calendars(params: $params) {\\n    date\\n    schedule {\\n      ... on CalendarAppointment {\\n        ...appointment\\n        __typename\\n      }\\n      ... on CalendarAvailabilityBlock {\\n        ...calendarAvailability\\n        __typename\\n      }\\n      ... on CalendarDropoffAvailability {\\n        ...dropOffAvailability\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment appointment on CalendarAppointment {\\n  __typename\\n  id\\n  confirmed\\n  startsAt\\n  status\\n  durationInMinutes\\n  appointmentType {\\n    id\\n    abbreviation\\n    label\\n    color {\\n      key\\n      hexCode\\n      textHexCode\\n      __typename\\n    }\\n    __typename\\n  }\\n  reason\\n  notes\\n  insertedAt\\n  createdBy {\\n    id\\n    nameFirst\\n    nameLast\\n    onPetOwnersBehalf\\n    __typename\\n  }\\n  calendar {\\n    id\\n    provider {\\n      id\\n      nameFirst\\n      nameLast\\n      credentials\\n      __typename\\n    }\\n    __typename\\n  }\\n  patient {\\n    id\\n    alerts {\\n      id\\n      label\\n      __typename\\n    }\\n    lastVisit {\\n      id\\n      checkOutAt\\n      checkInAt\\n      isActive\\n      status\\n      alerts {\\n        id\\n        label\\n        __typename\\n      }\\n      __typename\\n    }\\n    pimsId\\n    name\\n    nameFirst\\n    nameLast\\n    signalment\\n    deceasedDt\\n    account {\\n      id\\n      label\\n      note\\n      accountAlerts {\\n        id\\n        label\\n        __typename\\n      }\\n      primaryContact {\\n        nameFirst\\n        nameLast\\n        communicationDetails {\\n          ...communicationDetailInfo\\n          __typename\\n        }\\n        __typename\\n      }\\n      alternateContacts {\\n        nameFirst\\n        nameLast\\n        communicationDetails {\\n          ...communicationDetailInfo\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  service {\\n    id\\n    abbreviation\\n    label\\n    __typename\\n  }\\n  location {\\n    id\\n    label\\n    market {\\n      id\\n      timezone\\n      __typename\\n    }\\n    __typename\\n  }\\n  revisionHistory {\\n    at\\n    changes {\\n      fromValue\\n      changedKey\\n      toValue\\n      __typename\\n    }\\n    reviser {\\n      id\\n      nameFirst\\n      nameLast\\n      onPetOwnersBehalf\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment communicationDetailInfo on CommunicationDetail {\\n  id\\n  type\\n  value\\n  label\\n  note\\n  placeId\\n  isPreferred\\n  displayValue\\n  knownIssues\\n  communicationPreference {\\n    id\\n    allowCommunication\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment calendarAvailability on CalendarAvailabilityBlock {\\n  __typename\\n  id\\n  date\\n  startTime\\n  startsAt\\n  durationInMinutes\\n  endTime\\n  notes\\n  appointmentTypes {\\n    id\\n    abbreviation\\n    label\\n    color {\\n      key\\n      hexCode\\n      textHexCode\\n      __typename\\n    }\\n    defaultDurationInMinutes\\n    __typename\\n  }\\n  calendar {\\n    id\\n    provider {\\n      id\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment dropOffAvailability on CalendarDropoffAvailability {\\n  __typename\\n  id\\n  dailyDropoffLimit\\n  date\\n  dropoffs(statuses: $dropoffStatuses) {\\n    ...dropoffInfo\\n    __typename\\n  }\\n  startTime\\n  remainingDropoffs\\n  calendar {\\n    id\\n    provider {\\n      id\\n      nameFirst\\n      nameLast\\n      credentials\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment dropoffInfo on Dropoff {\\n  __typename\\n  id\\n  confirmed\\n  notes\\n  reason\\n  status\\n  location {\\n    id\\n    label\\n    __typename\\n  }\\n  appointmentType {\\n    label\\n    id\\n    abbreviation\\n    color {\\n      key\\n      hexCode\\n      textHexCode\\n      __typename\\n    }\\n    __typename\\n  }\\n  emailReminderOffsetInHours\\n  reminderSentAt\\n  isEmailSent\\n  patient {\\n    id\\n    alerts {\\n      id\\n      label\\n      __typename\\n    }\\n    lastVisit {\\n      id\\n      checkOutAt\\n      isActive\\n      checkInAt\\n      status\\n      alerts {\\n        id\\n        label\\n        __typename\\n      }\\n      __typename\\n    }\\n    pimsId\\n    name\\n    nameFirst\\n    nameLast\\n    signalment\\n    deceasedDt\\n    account {\\n      id\\n      label\\n      note\\n      accountAlerts {\\n        id\\n        label\\n        __typename\\n      }\\n      primaryContact {\\n        nameFirst\\n        nameLast\\n        communicationDetails {\\n          ...communicationDetailInfo\\n          __typename\\n        }\\n        __typename\\n      }\\n      alternateContacts {\\n        nameFirst\\n        nameLast\\n        communicationDetails {\\n          ...communicationDetailInfo\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n  service {\\n    id\\n    abbreviation\\n    label\\n    __typename\\n  }\\n}\\n\"}"
