            "text": "{\"operationName\":\"GetIntelligenceSettings\",\"variables\":{\"locationId\":\"1\"},\"query\":\"query GetIntelligenceSettings($locationId: ID!) {\\n  intelligenceSettings(locationId: $locationId) {\\n    ...IntelligenceSettingsInfo\\n    __typename\\n  }\\n}\\n\\nfragment IntelligenceSettingsInfo on IntelligenceSettings {\\n  id\\n  acceptedAt\\n  acceptedByUser {\\n    id\\n    nameFirst\\n    nameLast\\n    username\\n    __typename\\n  }\\n  features {\\n    agents\\n    assistant\\n    companion\\n    __typename\\n  }\\n  location {\\n    id\\n    label\\n    __typename\\n  }\\n  insertedAt\\n  updatedAt\\n  __typename\\n}\\n\"}"
