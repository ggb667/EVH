            "text": "{\"data\":{\"searchAccountsIndex\":{\"__typename\":\"PageOfAccountsIndex\",\"entries\":[{\"__typename\":\"Account\",\"accountAlerts\":[],\"id\":\"17579316-5a67-41e4-90ef-0ae73f4b9c9c\",\"isTestAccount\":false,\"label\":null,\"numberOfPatients\":9,\"pimsCode\":\"8762\",\"primaryContact\":{\"__typename\":\"Contact\",\"communicationDetails\":[{\"__typename\":\"CommunicationDetail\",\"displayValue\":\"P.O. Box 187,Tangerine, FL  32777\",\"id\":\"232bd20b-c565-4fd7-8966-9dbd10409a33\",\"isPreferred\":true,\"label\":null,\"type\":\"FULL_ADDRESS\",\"value\":\"P.O. Box 187,Tangerine, FL  32777\"},{\"__typename\":\"CommunicationDetail\",\"displayValue\":\"loonlov@aol.com\",\"id\":\"262a8a89-93a2-4b4e-a444-d171f3a25601\",\"isPreferred\":true,\"label\":\"client email\",\"type\":\"EMAIL\",\"value\":\"loonlov@aol.com\"},{\"__typename\":\"CommunicationDetail\",\"displayValue\":\"(352) 383-6029\",\"id\":\"9086016a-15fc-4cb8-bd67-b22bada24091\",\"isPreferred\":true,\"label\":\"Primary\",\"type\":\"PHONE\",\"value\":\"+13523836029\"},{\"__typename\":\"CommunicationDetail\",\"displayValue\":\"(352) 267-0916\",\"id\":\"bd56c07a-ed63-47b3-b8ac-3de526df7035\",\"isPreferred\":false,\"label\":\"Cell\",\"type\":\"PHONE\",\"value\":\"+13522670916\"},{\"__typename\":\"CommunicationDetail\",\"displayValue\":\"(352) 205-9694\",\"id\":\"dc19544e-8804-410a-b647-71f2a8eb7d25\",\"isPreferred\":false,\"label\":\"Spouse\",\"type\":\"PHONE\",\"value\":\"+13522059694\"}],\"id\":\"05dc9b11-61cc-4aeb-aadd-8074ec942e72\",\"nameFirst\":\"Deborah\",\"nameLast\":\"Burchill\"},\"runningLedger\":{\"__typename\":\"AccountRunningLedger\",\"agedBalances\":{\"__typename\":\"AgedBalances\",\"current\":207.24,\"over120\":0.0,\"over30\":0.0,\"over60\":0.0,\"over90\":0.0},\"balance\":207.24}}],\"found\":null}}}"
