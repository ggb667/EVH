            "text": "{\"operationName\":\"openTasks\",\"variables\":{\"params\":{\"assignedToId\":\"198\",\"assigneeType\":\"USER\",\"filters\":{\"statuses\":[\"OPEN\"],\"limit\":50}}},\"query\":\"query openTasks($params: ListTaskParams!) {\\n  tasks(params: $params) {\\n    counts {\\n      ...count\\n      __typename\\n    }\\n    tasksList {\\n      ...task\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment count on TaskCount {\\n  overdue\\n  today\\n  tomorrow\\n  total\\n  __typename\\n}\\n\\nfragment task on Task {\\n  assignedTo {\\n    ... on GroupCalendar {\\n      id\\n      label\\n      __typename\\n    }\\n    ... on User {\\n      id\\n      nameFirst\\n      nameLast\\n      __typename\\n    }\\n    __typename\\n  }\\n  completedBy {\\n    id\\n    nameFirst\\n    nameLast\\n    __typename\\n  }\\n  createdBy {\\n    id\\n    nameFirst\\n    nameLast\\n    __typename\\n  }\\n  completedAt\\n  insertedAt\\n  description\\n  dueDate\\n  dueTime\\n  id\\n  name\\n  note\\n  status\\n  patient {\\n    id\\n    name\\n    nameLast\\n    lastVisit {\\n      id\\n      __typename\\n    }\\n    pimsId\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
