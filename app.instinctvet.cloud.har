          "postData": {
            "mimeType": "application/json",
            "text": "{\"operationName\":\"getWardList\",\"variables\":{\"includeInactive\":false},\"query\":\"query getWardList($includeInactive: Boolean) {\\n  wards(includeInactive: $includeInactive) {\\n    ...wardInfo\\n    __typename\\n  }\\n}\\n\\nfragment wardInfo on Ward {\\n  id\\n  label\\n  abbreviation\\n  isActive\\n  feeProducts {\\n    ...feeProducts\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment feeProducts on FeeProduct {\\n  schedule {\\n    type\\n    frequencyInMinutes\\n    dailyTimes\\n    __typename\\n  }\\n  feeProduct {\\n    ...feeProduct\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment feeProduct on Product {\\n  id\\n  label\\n  defaultSchedule {\\n    type\\n    frequencyInMinutes\\n    dailyTimes\\n    __typename\\n  }\\n  pimsId\\n  __typename\\n}\\n\"}"
          }
        },
