          "postData": {
            "mimeType": "application/json",
            "text": "{\"operationName\":\"getActivePatientsAccounts\",\"variables\":{},\"query\":\"query getActivePatientsAccounts($patientsLimit: Int) {\\n  activeVisits {\\n    id\\n    patient {\\n      id\\n      pimsId\\n      account {\\n        ...accountFullInfo\\n        __typename\\n      }\\n      lastVisit {\\n        id\\n        __typename\\n      }\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment accountFullInfo on Account {\\n  id\\n  accountAlerts {\\n    id\\n    deactivatedAt\\n    label\\n    __typename\\n  }\\n  accountTypes {\\n    id\\n    label\\n    __typename\\n  }\\n  label\\n  note\\n  pimsCode\\n  numberOfPatients\\n  patients(limit: $patientsLimit) {\\n    id\\n    pimsId\\n    name\\n    signalment\\n    lastVisit {\\n      id\\n      __typename\\n    }\\n    __typename\\n  }\\n  primaryContact {\\n    ...contactInfo\\n    __typename\\n  }\\n  alternateContacts {\\n    ...contactInfo\\n    __typename\\n  }\\n  isTestAccount\\n  __typename\\n}\\n\\nfragment contactInfo on Contact {\\n  id\\n  nameFirst\\n  nameMiddle\\n  nameLast\\n  note\\n  isActive\\n  birthDate\\n  governmentId\\n  title {\\n    key\\n    __typename\\n  }\\n  accounts {\\n    id\\n    pimsCode\\n    __typename\\n  }\\n  communicationDetails {\\n    ...communicationDetailInfo\\n    __typename\\n  }\\n  __typename\\n}\\n\\nfragment communicationDetailInfo on CommunicationDetail {\\n  id\\n  type\\n  value\\n  label\\n  note\\n  placeId\\n  isPreferred\\n  displayValue\\n  knownIssues\\n  communicationPreference {\\n    id\\n    allowCommunication\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
          }
        },
