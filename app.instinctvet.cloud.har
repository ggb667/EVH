            "mimeType": "application/json",
            "text": "{\"operationName\":\"searchAccountsIndexFinancials\",\"variables\":{\"params\":{\"q\":\"Deborah Burchill\",\"perPage\":50}},\"query\":\"query searchAccountsIndexFinancials($params: SearchAccountIndexParams, $overdueInvoicesOnly: Boolean) {\\n  searchAccountsIndex(params: $params) {\\n    entries {\\n      ...financialsAccountInfo\\n      runningLedger(overdueInvoicesOnly: $overdueInvoicesOnly) {\\n        balance\\n        agedBalances {\\n          current\\n          over30\\n          over60\\n          over90\\n          over120\\n          __typename\\n        }\\n        __typename\\n      }\\n      __typename\\n    }\\n    found\\n    __typename\\n  }\\n}\\n\\nfragment financialsAccountInfo on Account {\\n  id\\n  pimsCode\\n  label\\n  isTestAccount\\n  numberOfPatients\\n  accountAlerts {\\n    id\\n    label\\n    __typename\\n  }\\n  primaryContact {\\n    id\\n    nameFirst\\n    nameLast\\n    communicationDetails {\\n      id\\n      type\\n      value\\n      label\\n      displayValue\\n      isPreferred\\n      __typename\\n    }\\n    __typename\\n  }\\n  __typename\\n}\\n\"}"
