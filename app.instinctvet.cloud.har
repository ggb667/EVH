            "text": "{\"operationName\":\"UserDetails\",\"variables\":{\"id\":\"198\"},\"query\":\"query UserDetails($id: ID!) {\\n  user(id: $id) {\\n    ...userDetails\\n    __typename\\n  }\\n}\\n\\nfragment userDetails on User {\\n  avatar {\\n    kind\\n    accent\\n    illustrationKey\\n    __typename\\n  }\\n  credentials\\n  id\\n  initials\\n  instinctId\\n  isActive\\n  isWhiteboard\\n  nameFirst\\n  nameFull\\n  nameLast\\n  nameMiddle\\n  pinCode\\n  roles {\\n    id\\n    label\\n    __typename\\n  }\\n  status\\n  title {\\n    key\\n    abbreviation\\n    label\\n    __typename\\n  }\\n  username\\n  __typename\\n}\\n\"}"
